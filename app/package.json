{
  "name": "calculator-app",
  "version": "1.2.0",
  "description": "A simple calculator application built with Node.js for CI/CD EKS deployment",
  "main": "index.js",
  "private": true,
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "jest --ci --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "health": "curl -f http://localhost:3000/health || exit 1"
  },
  "dependencies": {},
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-promise": "^6.6.0",
    "eslint-plugin-security": "^2.1.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.7"
  },
  "keywords": [
    "nodejs",
    "calculator",
    "jest",
    "testing",
    "kubernetes",
    "docker",
    "ci-cd"
  ],
  "author": "Harshhaa",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NotHarshhaa/CI-CD_EKS-GitHub_Actions.git"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "*.js",
      "!*.test.js",
      "!.eslintrc.js",
      "!node_modules/**",
      "!coverage/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  }
}
